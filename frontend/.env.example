# Copy this file to .env.local for local development (frontend/ only).
# Vite only exposes variables prefixed with VITE_ to client code.

# Base URL of the backend API. No trailing slash.
# The apiClient prefixes every call with this + /api/...
VITE_API_BASE_URL=http://localhost:8000

# When true, apiClient.js serves responses from frontend/src/mock/mockData.js
# instead of calling the network. Useful while backend routes are still
# stubs (see backend/app/api/*.py, currently empty) or when a specific
# endpoint isn't wired up yet. Flip to false once the real API is ready.
VITE_USE_MOCK_DATA=true
