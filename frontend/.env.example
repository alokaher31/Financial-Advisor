# Copy this file to .env.local for local development (frontend/ only).
# Vite only exposes variables prefixed with VITE_ to client code.

# Base URL of the backend API. No trailing slash.
# The apiClient prefixes every call with this + /api/...
VITE_API_BASE_URL=http://localhost:8000

# When true, apiClient.js serves fixed responses from frontend/src/mock/mockData.js
# instead of calling the backend. Keep this false for calculations based on
# values entered in the forms; enable it only for UI-only demos.
VITE_USE_MOCK_DATA=false
