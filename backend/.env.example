# Application Settings
APP_NAME="Financial Advisor API"
APP_VERSION="1.0.0"
DEBUG=False

# API Settings
API_V1_PREFIX="/api/v1"

# Database Settings
# For SQLite (default):
DATABASE_URL="sqlite:///./financial_advisor.db"
# For PostgreSQL:
# DATABASE_URL="postgresql+psycopg2://user:password@localhost:5432/financial_advisor"
DB_ECHO=False

# Groq API Settings (REQUIRED)
GROQ_API_KEY="your-groq-api-key-here"
GROQ_MODEL="openai/gpt-oss-120b"
GROQ_TEMPERATURE=0.7
GROQ_MAX_TOKENS=4096

# LLM Settings
LLM_MAX_RETRIES=3
LLM_RETRY_DELAY=1.0
LLM_TIMEOUT=30

# Security Settings
SECRET_KEY="change-this-to-a-random-secret-key-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Logging Settings
LOG_LEVEL="INFO"

# Financial Planning Defaults
DEFAULT_INFLATION_RATE=0.03
DEFAULT_SAVINGS_RATE=0.05
DEFAULT_EQUITY_RETURN=0.12
DEFAULT_DEBT_RETURN=0.08

# CORS Settings (comma-separated origins)
# CORS_ORIGINS="http://localhost:3000,http://localhost:5173"
